import entrega2y3.*

//Táctica auxiliar para tests.
const tacticaAux = new TacticaAgil()

describe "Grupo de Tests para el Arsenal" {
	const enanoTest = new Enano(factorDePoder=5, vida=50, tactica=tacticaAux)
  test "Espada con multiplicador de 15 y llevada Enano"{
		const espadaTest = new Espada(poderBase=15)
		assert.equals(300,espadaTest.poder(enanoTest))
  }
	test "Espada con multiplicador de 5 y llevada por guerrero con 3 armas"{
		const espadaTest = new Espada(poderBase=5)
		assert.equals(150,espadaTest.poder(object inherits Hobbit(vida=50, tactica=tacticaAux){override method cantidadDeArmas()=3}))
	}
	test "Daga con multiplicador 20 y lleva Élfico"{
		const dagaTest = new Daga(poderBase=20)
		const elfoTest = new Elfo(destrezaPropia=5, vida=50, tactica=tacticaAux)
		assert.equals(250,dagaTest.poder(elfoTest))
	}
	test "Daga con multiplicador 10 y lleva Humano"{
		const dagaTest = new Daga(poderBase=10)
		const humanoTest = new Humano(limitadorDePoder=5,vida=50, tactica=tacticaAux)
		assert.equals(75,dagaTest.poder(humanoTest))
	}
	test "Hacha con mango de 50cm, con una hoja de 5kg"{
		const hachaTest = new Hacha(mango=50, hoja=5)
		assert.equals(250,hachaTest.poder(enanoTest))
	}
	test "Hacha con mango de 75cm, con una hoja de 15kg"{
		const hachaTest = new Hacha(mango=75, hoja=15)
		assert.equals(1125,hachaTest.poder(enanoTest))
	}
}

describe "Grupo de Tests para Guerreros" {
	test "Poder de Frodo (sin items)"{
		assert.equals(50,frodo.poder())
	}
	test "Poder de Gimli"{
		assert.equals(2175,gimli.poder())
	}
	test "Poder de Légolas"{
		assert.equals(980,legolas.poder())
	}
	test "Poder de Aragorn"{
		assert.equals(102.25,aragorn.poder())
	}
	test "Poder de Gandalf"{
		assert.equals(2700,gandalf.poder())
	}
	test "Poder de Gandalf con 9 de vida y todas sus armas"{
		gandalf.vida(9)
		assert.equals(3900,gandalf.poder())
	}
  test "Poder de Légolas que obtiene medio punto de destreza propia"{
    legolas.aumentarDestrezaPropia(0.5)
    assert.equals(1130,legolas.poder())
  }
  test "Poder de Gollum"{
    assert.equals(50,gollum.poder())
  }
}

describe "Grupo de Tests para Zonas y Guerreros Individuales" {
	test "Zona de poder atravesada por varios guerreros de poder distinto"{
		const zonaTest = new ZonaQueDemandaPoder(poderNecesario=1500)	
		const viajero1 = new Maiar(vida=105, armas=[], tactica=tacticaAux)
		const viajero2 = new Maiar(vida=20, armas=[], tactica=tacticaAux)
		assert.that(zonaTest.puedePasar(viajero1))
		assert.notThat(zonaTest.puedePasar(viajero2))
	}
	test "Zona de armas atravesada por varios guerreros"{
		const zonaTest = new ZonaQueDemandaArmas(vidaAQuitar=75)
		const viajero1 = new Humano(vida=50, limitadorDePoder=5, armas=[anduril], tactica=tacticaAux)
		const viajero2 = new Humano(vida=50, limitadorDePoder=5, armas=[], tactica=tacticaAux)
		assert.that(zonaTest.puedePasar(viajero1))
		assert.notThat(zonaTest.puedePasar(viajero2))
		zonaTest.atravesar(viajero1)
		assert.that(viajero1.estaMuerto())
	}
}

describe "Grupo de Tests para Caminos, Grupos y Requerimientos Generales" {
	const requerimiento1 = new RequerimientoDePoder(cantidadNecesaria=2000)
	const zona1 = new ZonaQueDemandaArmas(vidaAQuitar=5, requerimientoDeZona=requerimiento1)
	const requerimiento2 = new RequerimientoDeVida(cantidadNecesaria=50)
	const zona2 = new ZonaQueDemandaPoder(poderNecesario=1500, requerimientoDeZona=requerimiento2)
	const caminoTest = new Camino(zonas=[zona1,zona2])
	const grupoTest = new Grupo(miembros=[gimli,gandalf])

	test "Grupo de Gandalf y Gimli puede pasar el camino"{
		assert.that(caminoTest.grupoPuedePasar(grupoTest))
	}
	test "Mismo grupo sumado por Légolas no puede pasar el camino"{
		grupoTest.sumarMiembro(legolas)
		assert.notThat(caminoTest.grupoPuedePasar(grupoTest))
	}
	test "Tom Bombadil puede pasar Lebennin pero no Minas Tirith"{
		assert.that(lebennin.puedePasar(tomBombadil))
		assert.notThat(minasTirith.puedePasar(tomBombadil))
	}
}

describe "Grupo de Tests para una Zona con Requerimiento de Elementos" {
	const requerimientoTest = new RequerimientoDeElemento(cantidad=30, nombreDeElemento="Lembas")
	const zonaTest = new ZonaQueDemandaPoder(poderNecesario=25, requerimientoDeZona=requerimientoTest)
	const viajero1 = new Humano(vida=50, limitadorDePoder=5, elementos=[new Elemento(cantidad=16, nombre="Lembas")], tactica=tacticaAux)
	const viajero2 = new Humano(vida=50, limitadorDePoder=5, elementos=[new Elemento(cantidad=16, nombre="Lembas")], tactica=tacticaAux)
	const grupoTest = new Grupo(miembros=[viajero1])

	test "Grupo de una persona no puede pasar el requerimiento de la zona"{
		assert.notThat(zonaTest.grupoPuedePasar(grupoTest))
	}
	test "Grupo de dos personas puede pasar el requerimiento de la zona"{
		grupoTest.sumarMiembro(viajero2)
		assert.that(zonaTest.grupoPuedePasar(grupoTest))
	}
}