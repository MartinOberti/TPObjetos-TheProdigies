import entrega2y3.*

describe "Grupo de Tests para las Tácticas de Combate" {
  test "Légolas se enfrenta contra Gandalf. Ambos mueren"{
    legolas.enfrentarse(gandalf)
    assert.that(legolas.estaMuerto())
    assert.that(gandalf.estaMuerto())
  }
  test "Gandalf se enfrenta a Frodo y evita ser atacado. Frodo muere"{
    gandalf.enfrentarse(frodo)
    assert.equals(100,gandalf.vida())
    assert.that(frodo.estaMuerto())
  }
  test "Aragorn se enfrenta contra Gollum y recibe daño reducido. Ambos sobreviven"{
    aragorn.enfrentarse(gollum)
    assert.equals(82.5,aragorn.vida())
    assert.that(aragorn.estaVivo())
    assert.that(gollum.estaVivo())
  }
  test "Frodo huye de Tom Bombadil, perdiendo 10 de vida"{
    frodo.enfrentarse(tomBombadil)
    assert.equals(40,frodo.vida())
  }
  test "Un guerrero muerto no puede enfrentarse con nadie"{
    frodo.matar()
    assert.throwsException({frodo.enfrentarse(tomBombadil)})
  }
}

describe "Grupo de Tests para Penalidades de Caminos" {
  const penalidad1 = new PenalidadDeMuerte()
  const penalidad2 = new PenalidadDeDanio(valorQuitado=25)
  const penalidad3 = new PenalidadDeArma()
  const zonaTest = new ZonaQueDemandaPoder(poderNecesario=2500)

  test "Gimli no puede atravesar el camino y pierde una de sus armas"{
    const caminoTest = new Camino(zonas=[zonaTest],penalidades=[penalidad3])
    caminoTest.atravesar(gimli)
    assert.equals(1,gimli.cantidadDeArmas())
  }
  test "Legolas no puede atravesar el camino y pierde 25 puntos de vida"{
    const caminoTest = new Camino(zonas=[zonaTest],penalidades=[penalidad2])
    caminoTest.atravesar(legolas)
    assert.equals(55,legolas.vida())
  }
  test "Frodo no puede atravesar el camino, se muere y pierde su única arma"{
    const caminoTest = new Camino(zonas=[zonaTest],penalidades=[penalidad1,penalidad3])
    caminoTest.atravesar(frodo)
    assert.that(frodo.estaMuerto())
    assert.notThat(frodo.tieneArmas())
  }
  test "Grupo de Gandalf y Tom Bombadil puede atravesar la zona y no recibe ninguna penalidad"{
    const caminoTest = new Camino(zonas=[zonaTest],penalidades=[penalidad1,penalidad2,penalidad3])
    const grupoTest = new Grupo(miembros=[gandalf,tomBombadil])
    caminoTest.grupoAtravesar(grupoTest)
    assert.equals(100,gandalf.vida())
    assert.that(gandalf.estaVivo())
    assert.equals(2,gandalf.cantidadDeArmas())
    assert.that(tomBombadil.estaVivo())
  }
}

describe "Grupo de Tests para los Anillos" {
  test "Frodo usa su anillo de fuego, ataca a Gollum y recibe su contraataque"{
    frodo.usarAnillo()
    assert.equals(70,gollum.vida())
    assert.equals(95.5,frodo.vida())
  }
  test "Aragorn usa su anillo y pierde su arma más poderosa"{
    const armaMasPoderosa = aragorn.armaMasPoderosa()
    aragorn.usarAnillo()
    assert.notThat(aragorn.armas().contains(armaMasPoderosa))
  }
  test "Gimli usa su anillo de aire"{
    gimli.usarAnillo()
    assert.equals(80,frodo.vida())
  }
  test "Gollum usa su anillo único"{
    gollum.usarAnillo()
    assert.equals(70,gollum.vida())
  }
  test "Gollum usa su anillo único teniendo 3 armas"{
    gollum.guardarArma(anduril)
    gollum.guardarArma(dagaDeAragorn)
    gollum.guardarArma(espadaDeLegolas)
    gollum.guardarArma(baculoDeGandalf)
    gollum.usarAnillo()
    assert.equals(80,gollum.vida())
  }
}